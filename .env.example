# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Base URL used to build public file URLs and upload targets.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Untuk `npm run dev` di host. Docker Compose menimpa nilai ini dengan
# connection string ke service `postgres`.
DATABASE_URL=postgresql://fronli:fronli@127.0.0.1:5432/mobile_api?schema=public

# ─── Docker Compose (khusus `docker compose up`) ──────────────────────────────
# Ganti POSTGRES_PORT bila port 5432 di host sudah dipakai PostgreSQL lain.
POSTGRES_USER=fronli
POSTGRES_PASSWORD=fronli
POSTGRES_DB=mobile_api
POSTGRES_PORT=5432

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="SOS Student On Study <onboarding@resend.dev>"
# Set to `console` for local development to print OTPs instead of sending email.
EMAIL_DRIVER=

# ─── Storage (local adapter) ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
# Optional: separate secret for signed file URLs (falls back to JWT_SECRET).
FILE_URL_SECRET=

# ─── Admin seed (npm run db:seed) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@sos.ac.id
ADMIN_PASSWORD=change_me
ADMIN_NAME="SOS Admin"

# ─── Payment (not configured yet) ─────────────────────────────────────────────
# All topup/withdrawal/webhook endpoints return 501 until a provider is wired in.
PLATFORM_FEE_PERCENT=0
